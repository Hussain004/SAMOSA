#!/bin/sh
# The files that are generated from the engine are committed, so they have to
# be regenerated whenever the engine or the corpus changes. The CI checks that
# they are what the engine says today, and this hook makes sure of it.
set -e
node scripts/build-pkg.mjs > /dev/null
node scripts/gen-demo.ts --write > /dev/null
node scripts/gen-tex.ts --write > /dev/null
# the build output is tracked, so it is added even though "dist" is ignored
git add -f pkg/dist pkg/README.md
git add src/landing/generated.json src/landing/generated-tex.json

{
  "name": "samosa-math",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SAMOSA: a step auditor for matrix algebra, stochastics and algebra. Checks every step of a derivation, exactly, in your browser.",
  "license": "MIT",
  "homepage": "https://samosa-math.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hussain004/SAMOSA.git"
  },
  "keywords": [
    "math",
    "linear-algebra",
    "matrix-calculus",
    "latex",
    "linter",
    "kalman-filter",
    "machine-learning",
    "mcp",
    "agent-skills"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-docs.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "build:pkg": "node scripts/copy-docs.mjs && node scripts/build-pkg.mjs",
    "gen:demo": "vite-node scripts/gen-demo.ts --write",
    "gen:tex": "vite-node scripts/gen-tex.ts --write",
    "publish:pkg": "npm run build:pkg && npm publish --access public --prefix pkg",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "test:e2e": "playwright test",
    "check:corpus": "node scripts/check-corpus.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "decimal.js": "^10.6.0",
    "fflate": "^0.8.3",
    "katex": "^0.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@unified-latex/unified-latex-util-environments": "^1.8.4",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "@unified-latex/unified-latex-util-print-raw": "^1.8.4",
    "@unified-latex/unified-latex-util-split": "^1.8.4",
    "@unified-latex/unified-latex-util-visit": "^1.8.4",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.12",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
